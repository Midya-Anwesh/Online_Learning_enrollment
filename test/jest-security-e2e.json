{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "authorization.e2e-spec.ts$",
  "testTimeout": 30000,
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^datasource$": "<rootDir>/datasource"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
